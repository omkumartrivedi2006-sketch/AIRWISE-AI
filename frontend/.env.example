# AIRWISE AI — Frontend Environment Configuration
# Copy this file to .env.local for local frontend development.
# Only variables prefixed with NEXT_PUBLIC_ will be exposed to the browser.
# DO NOT ADD PRIVATE SECRETS OR GEMINI_API_KEY TO THIS FILE.

NEXT_PUBLIC_APP_NAME="AIRWISE AI"
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_ENVIRONMENT="development"
