# ==============================================================================
# AIRWISE AI — Root Environment Configuration Template
# Copy this file to .env and configure the variables for your environment.
# DO NOT COMMIT REAL SECRETS OR SENSITIVE KEYS TO VERSION CONTROL.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
API_V1_PREFIX=/api/v1

# Security & CORS
# Secret key used for signing internal tokens (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string-in-production
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg://username:password@hostname:port/database_name
# For local development with PostgreSQL:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/airwise_db
# Test database URL (optional):
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/airwise_test_db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Google Gemini AI Configuration
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
# SERVER-SIDE ONLY: Never prefix with NEXT_PUBLIC_ or expose to the frontend.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=2048
