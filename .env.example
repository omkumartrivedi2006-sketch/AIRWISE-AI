 # ==============================================================================
# AIRWISE AI — Root Environment Configuration Template
# Copy this file to .env and configure the variables for your environment.
# DO NOT COMMIT REAL SECRETS OR SENSITIVE KEYS TO VERSION CONTROL.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
API_V1_PREFIX=/api/v1
ENABLE_DOCS=True

# Security & Rate Limiting (Module 10)
MAX_REQUEST_SIZE_BYTES=10485760
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=60
AUTH_RATE_LIMIT_REQUESTS_PER_MINUTE=15

# Security, Authentication & Session Cookies (Module 04)
# Secret key used for signing internal tokens & JWTs (generate with: openssl rand -hex 32)
SECRET_KEY=b57ce65a8f9146a94f7fc1f8e72e911478c182cc38a5cad3addd8b750ebfe8f9
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_HOURS=1
EMAIL_VERIFICATION_EXPIRE_HOURS=24
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Email Service (console, smtp)
EMAIL_PROVIDER=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=no-reply@airwise.ai
EMAILS_FROM_NAME=AIRWISE AI

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Database Configuration (MongoDB Primary)
# Local MongoDB: mongodb://localhost:27017
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/airwise_db?retryWrites=true&w=majority
DB_NAME=airwise_db
MONGODB_MAX_POOL_SIZE=50   
MONGODB_MIN_POOL_SIZE=5
MONGODB_TIMEOUT_MS=5000

# Legacy compatibility (optional)
DATABASE_URL=mongodb://localhost:27017/airwise_db
DB_POOL_RECYCLE=1800

# Google Gemini AI Configuration (Module 05)
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
# SERVER-SIDE ONLY: Never prefix with NEXT_PUBLIC_ or expose to the frontend.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT_SECONDS=30

# AI Configuration & Safeguards
AI_ENABLED=true
AI_MAX_INPUT_LENGTH=5000
AI_MAX_HISTORY_MESSAGES=20
AI_MAX_DAILY_REQUESTS=50

# Environmental Data & Live Telemetry Configuration (Module 06)
ENVIRONMENTAL_DATA_ENABLED=true
PRIMARY_AIR_QUALITY_PROVIDER=open-meteo
SECONDARY_AIR_QUALITY_PROVIDER=waqi

# Optional Provider Credentials
# Open-Meteo works without an API key for open/research use
OPENAQ_API_KEY=
# Obtain a free token from https://aqicn.org/data-platform/token/ (Optional secondary provider)
WAQI_API_TOKEN=f27d2376e2e380f9a7999df7f151130b714c5017

# Cache & Reliability Configuration
AIR_QUALITY_CACHE_TTL_SECONDS=900
WEATHER_CACHE_TTL_SECONDS=1800
ENVIRONMENTAL_API_TIMEOUT_SECONDS=15
MAX_FRESH_DATA_AGE_MINUTES=120

# Personalization, Alerts & Notifications (Module 08)
NOTIFICATIONS_ENABLED=true
EMAIL_NOTIFICATIONS_ENABLED=false
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@airwise.ai
ALERT_EVALUATION_ENABLED=true
ALERT_DEFAULT_COOLDOWN_MINUTES=60
RECOMMENDATIONS_ENABLED=true
RECOMMENDATION_CACHE_TTL_SECONDS=3600
