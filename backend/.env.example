# AIRWISE AI Backend Environment Configuration
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Server Config
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=dev-secret-key-change-in-production-min32chars
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (MongoDB Primary)
# Local: mongodb://localhost:27017 or Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net
MONGODB_URI=mongodb://localhost:27017
DB_NAME=airwise_db
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_TIMEOUT_MS=5000

# Google Gemini API
# Server-side only key. Never expose in client code.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=2048
